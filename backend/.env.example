# ==============================================================================
# BODYCRAFT TN - Environment Configuration Example
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
PLATFORM_NAME="BODYCRAFT TN — Bus & Lorry Body Building Platform"

# MongoDB Database Connection
# Replace with your local or MongoDB Atlas connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/bodycraft_tn

# JWT Authentication Secrets
JWT_SECRET=bodycraft_tn_super_secure_jwt_secret_key_2026_chennai_karur
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_ORIGIN=http://localhost:5173

# Optional Cloudinary Configuration (Vehicle & Stage Photos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional SMS / Email Notifications
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=notifications@bodycraft-tn.com
